{
    "interface_version": 2,
    "name": "maa-game-template",
    "title": "MAA Game Template",
    "description": "MaaFramework game automation project template.",
    "version": "v0.0.0",
    "github": "https://github.com/tomato90s/maa-game-template",
    "welcome": "Welcome to MAA Game Template. This project contains sample tasks and default Python custom actions. Edit interface.json and resources according to your game project.",
    "controller": [
        {
            "name": "Android",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "Default",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [],
    "group": [
        {
            "name": "system",
            "label": "System"
        },
        {
            "name": "example",
            "label": "Examples"
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "-u",
            "./../agent/main.py"
        ]
    },
    "option": {},
    "import": [
        "resource/tasks/system/startup_task.json",
        "resource/tasks/example/example_task.json"
    ]
}
